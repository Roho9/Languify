MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
// Full capabilities need a paid Apple Developer Program team (Sign in with
// Apple, iCloud). Override in Config/Local.xcconfig if you only have a free team.
LANGUIFY_ENTITLEMENTS = App/Resources/Languify.entitlements
// Backend for AI features. Local dev: run `npm run dev` in backend/ and point
// this at your Mac's LAN address from Local.xcconfig, e.g. http:/$()/192.168.1.20:8787
LANGUIFY_API_BASE_URL =
#include? "Local.xcconfig"
