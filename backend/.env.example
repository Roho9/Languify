# Copy to .env and fill in. Never commit .env.
PORT=8787
# 32+ random characters: openssl rand -base64 48
LANGUIFY_TOKEN_SECRET=
# AI provider: "ollama" (free, local; default) or "claude" (Anthropic API).
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
# gemma3:27b needs about 20 GB of free memory; use gemma3:12b on 16 GB Macs.
OLLAMA_MODEL=gemma3:27b
OLLAMA_TIMEOUT_MS=90000
OLLAMA_KEEP_ALIVE=30m
# Only for AI_PROVIDER=claude. Read by the Anthropic SDK. Server-side only; never put this in the iOS app.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
REWIND_EFFORT=low
TUTOR_EFFORT=low
LESSON_EFFORT=medium
AI_TIMEOUT_MS=20000
APPLE_BUNDLE_ID=app.languify.Languify
# Xcode for local .storekit testing, Sandbox for TestFlight, Production for release.
APP_STORE_ENVIRONMENT=Xcode
# Folder containing AppleRootCA-G3.cer etc. (https://www.apple.com/certificateauthority/)
APPLE_ROOT_CERTS_DIR=
# APPLE_APP_ID=  (numeric App Store id, required for Production)
